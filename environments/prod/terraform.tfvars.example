# ==============================================================================
# Production Environment Variable Values Example Template
# Copy this file to terraform.tfvars and adjust values as needed.
# ==============================================================================

# AWS Region Configuration
aws_region  = "ap-south-1"
environment = "prod"

# VPC & Network Configuration
vpc_cidr             = "10.2.0.0/16"
public_subnet_cidrs  = ["10.2.1.0/24", "10.2.2.0/24", "10.2.3.0/24"]
private_subnet_cidrs = ["10.2.10.0/24", "10.2.11.0/24", "10.2.12.0/24"]
availability_zones   = ["ap-south-1a", "ap-south-1b", "ap-south-1c"]

# EC2 Compute Configuration
instance_type    = "t3.medium"
root_volume_size = 20
root_volume_type = "gp3"

# Additional EBS Volume Configuration
create_additional_volume = true
additional_volume_size   = 50
additional_volume_type   = "gp3"

# OS / AMI Configuration (Ubuntu 24.04 LTS Noble Numbat)
ami_owner       = "099720109477"
ami_name_filter = "ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"

